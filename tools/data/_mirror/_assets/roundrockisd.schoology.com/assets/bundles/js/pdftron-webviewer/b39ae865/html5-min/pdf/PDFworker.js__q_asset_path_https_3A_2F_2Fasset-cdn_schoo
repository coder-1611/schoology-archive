function sgyGetAssetPath() {
  if (sgyGetAssetPath.assetPath) {
    return sgyGetAssetPath.assetPath;
  }
  else if (!self.location.search) {
    return "";
  }

  var params = {};
  var search = decodeURIComponent(self.location.search.slice(1));
  var definitions = search.split('&');
  definitions.forEach(function(val) {
    var parts = val.split('=', 2);
    params[parts[0]] = parts[1];
  });
  var assetPath = params.asset_path ? params.asset_path + "pdf/" : "";

  if (assetPath) {
    // see PE-102838 for jsfiddle testing script for valid paths
    // Decode so that we can parse the url correctly
    var assetUrl = new URL(decodeURIComponent(assetPath));
    var validDomains = new RegExp('^schoology(ca|stg|test)?\.com$');

    // no user uploaded files, only static assets
    var validPathname = new RegExp('^/assets/');

    // allow schoology domains or samesite
    var assetDomain = getDomainAndTld(assetUrl.hostname);
    var originDomain = getDomainAndTld(location.hostname);
    var isValidHost = validDomains.test(assetDomain) || assetDomain === originDomain;

    // block malicious script loading
    if (!isValidHost || !validPathname.test(assetUrl.pathname)) {
      console.warn('disallowed script loading from url', assetPath);
      return '';
    }
  }

  sgyGetAssetPath.assetPath = assetPath;
  return assetPath;
}

function getDomainAndTld(hostname) {
  if (!hostname || hostname.length < 1) {
    return '';
  }
  var hostnameParts = hostname.split('.');
  while (hostnameParts.length > 2) {
      hostnameParts.shift();
  }
  return hostnameParts.join('.');
}

