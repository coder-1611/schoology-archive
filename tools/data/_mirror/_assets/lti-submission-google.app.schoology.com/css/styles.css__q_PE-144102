    color: #666;
    font-size: 12px;
    font-weight: normal;
}
.search-box-input::-moz-placeholder {
    /* Firefox 19+ */
    color: #666;
    font-size: 12px;
    font-weight: normal;
}
.search-box-input:-ms-input-placeholder {
    /* IE 10+ */
    color: #666;
    font-size: 12px;
    font-weight: normal;
}
.search-box-input:-moz-placeholder {
    /* Firefox 18- */
    color: #666;
    font-size: 12px;
    font-weight: normal;
}
.search-box-input::placeholder {
    /* CSS3 */
    color: #666;
    font-size: 12px;
    font-weight: normal;
}
/* END: Defining placeholder style for different browsers */

