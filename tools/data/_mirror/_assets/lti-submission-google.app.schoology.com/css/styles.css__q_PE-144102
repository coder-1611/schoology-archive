.drive-list-table .drive-list-cell.drive-list-header { padding-top: 0; padding-bottom: 7px; vertical-align: bottom; text-align: start; }
.drive-list-table .file-item-checkbox { width: 22px; padding-inline-start: 20px; vertical-align: top; }
.drive-list-table .file-item-icon { width: 25px; text-align: center; padding-inline-end: 5px; vertical-align: top; }
.drive-list-table .file-item-icon .drive-file-icon-image { margin-bottom: -3px; }
.drive-list-table .file-item-title { color: #333; font-size: 14px; font-weight: bold; }
.drive-list-table .drive-list-header.file-item-title { font-size: 12px; }
.drive-list-table .file-item-actions { width: 40px; padding-inline-end: 20px; vertical-align: top; font-size: 12px; }
.drive-list-table .file-item-actions a { color: #1a5597;  }
.drive-list-table .shared { color: #666; font-size: 11px; }
.ajax-load-more { color: #327cbb; display: inline-block; margin: 10px 20px; background: url("/mirror/_assets/lti-submission-google.app.schoology.com/img/arrow-down.png") no-repeat 9px 50%; padding-inline-start: 24px; }

/* Progress Bars */
.progress { height: 10px; background: #f5f5f5; border: 1px solid #ddd; }
.progress-bar { float: left; width: 0px; height: 100%; margin: -1px; background-color: #70c2e8; border: 1px solid #257499; -webkit-box-shadow: inset 0 1px 0 rgba(255,255,255,0.34); -moz-box-shadow: inset 0 1px 0 rgba(255,255,255,0.34); -ms-box-shadow: inset 0 1px 0 rgba(255,255,255,0.34); -o-box-shadow: inset 0 1px 0 rgba(255,255,255,0.34); box-shadow: inset 0 1px 0 rgba(255,255,255,0.34); -webkit-transition: width 0.6s ease; -moz-transition: width 0.6s ease; -ms-transition: width 0.6s ease; -o-transition: width 0.6s ease; transition: width 0.6s ease; }
[dir="rtl"] .progress-bar{
    float: right;
}
.progress-bar.progress-bar-success { background-color: #b1e084; border-color: #7cad4d; }
.progress-bar.progress-bar-warning { background-color: #ffc600; border-color: #d0a100; }

/* Bulk Import Box */
body .popups-import-item.ui-dialog .ui-dialog-content { padding-bottom: 0; }
.import-title { width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; word-wrap: normal; }
.bulk-item-title { font-weight: bold; }
.warning-text { font-size: 11px; color: #e20000; text-align: center; }
.files-uploaded { padding-inline-start: 20px; color: #666; }
.files-uploaded img { float: left; margin-inline-start: -20px; }
[dir="rtl"] .files-uploaded img{
    float: right;
}

/* Tipsy plugin */
.tipsy { padding: 5px; font-size: 10px; position: absolute; z-index: 100000; }
.tipsy-inner { padding: 5px 8px 4px 8px; background-color: black; color: white; max-width: 200px; text-align: center; }
.tipsy-inner { border-radius: 3px; -moz-border-radius:3px; -webkit-border-radius:3px; }
.tipsy-arrow { position: absolute; background: url("/mirror/_assets/lti-submission-google.app.schoology.com/img/tipsy.gif") no-repeat top left; width: 9px; height: 5px; }
.tipsy-s .tipsy-arrow { bottom: 0; inset-inline-start: 50%; margin-inline-start: -4px; background-position: bottom left; }

